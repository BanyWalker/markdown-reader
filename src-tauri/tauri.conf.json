{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Reader",
  "version": "0.1.7",
  "identifier": "com.mdreader.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MD Reader v0.1.7",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self';",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx", "mdown", "mkdn"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "text", "log", "rst"],
        "name": "Text document",
        "description": "Plain text document",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ],
    "resources": {
      "assets/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "targets": ["nsis"]
  }
}
